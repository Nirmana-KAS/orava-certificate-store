# Copy to .env.local for local development. Never commit real values.
# On Vercel, add the same keys in Project → Settings → Environment Variables.

# ── App ──────────────────────────────────────
# Public URL of the deployed app (used for links and social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Supabase) ──────────────────────
# Supabase → Connect → "Transaction pooler" connection string (port 6543), with your DB password.
# Server-only: the browser never sees it.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Sign-in ──────────────────────────────────
# Long random secret (64+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later signs everyone out and needs a new admin setup.
AUTH_SECRET=
# The one admin account
ADMIN_EMAIL=shehannirmana.orava@gmail.com
# One-time token for the /admin/setup page (any long random text). Remove after setup if you like.
ADMIN_SETUP_TOKEN=

# ── Email (sign-in codes and alerts) ─────────
# Option A (recommended, free): Gmail with an App Password, can email any staff address (~500/day).
#   Google Account → Security → 2-Step Verification on → App passwords → create one.
SMTP_USER=shehannirmana.orava@gmail.com
SMTP_APP_PASSWORD=
# Option B (free): Resend. Without a verified domain it can only email the address you signed up with,
# so it suits admin alerts but not staff sign-in codes.
RESEND_API_KEY=
# Optional "From" line, e.g. Orava Certificate Store <shehannirmana.orava@gmail.com>
MAIL_FROM=

# ── Health checks (Phase 6) ──────────────────
# Shared secret that cron-job.org sends in the x-cron-secret header
CRON_SECRET=
# Optional: Vercel Deploy Hook URL used by "Diagnose & Fix" to redeploy
VERCEL_DEPLOY_HOOK_URL=
