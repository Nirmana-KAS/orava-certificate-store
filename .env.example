# Copy to .env.local for local development. Never commit real values.
# On Vercel, add the same keys in Project → Settings → Environment Variables.

# ── App ──────────────────────────────────────
# Public URL of the deployed app (used for links and social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 1) ───────────────────────
# Project → Settings → API. The service role key is server-only: never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sessions (Phase 1) ───────────────────────
# Long random string, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# ── Email alerts (Phase 1 / 6) ───────────────
# Resend free plan, signed up with the admin email below
RESEND_API_KEY=
ALERT_EMAIL_TO=shehannirmana.orava@gmail.com
# Fallback: Gmail SMTP with an app password (optional)
SMTP_USER=
SMTP_APP_PASSWORD=

# ── Health checks (Phase 6) ──────────────────
# Shared secret that cron-job.org sends in the x-cron-secret header
CRON_SECRET=
# Optional: Vercel Deploy Hook URL used by "Diagnose & Fix" to redeploy
VERCEL_DEPLOY_HOOK_URL=
