{
  "name": "orava-certificate-store",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Secure certificate store for orava (Pvt) Ltd.: search, review and download certificates.",
  "author": "Shehan Nirmana",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:all": "playwright test --config playwright.all.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.8.2",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "otplib": "13.5.0",
    "postgres": "4.0.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.35.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.16.1"
}
